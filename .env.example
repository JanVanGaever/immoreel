# --- App ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Auth --------------------------------------------------------------
# Ondertekent de sessiecookies. Minstens 32 tekens en per omgeving anders.
# Genereer er een met: openssl rand -base64 48
# Zonder deze waarde draait dev op een vaste ontwikkelsleutel; in productie
# start de app niet zonder.
AUTH_SECRET=""

# --- Intern adminpaneel (/admin) ---------------------------------------
# Komma-gescheiden e-mailadressen van interne medewerkers. Alleen zij zien
# /admin; voor iedereen anders bestaat die route niet (404, geen 403).
# Bewust geen rol in de databank: rollen horen bij een kantoor, dit paneel
# kijkt over alle kantoren heen. Wie erbij komt, is een deploy — geen klik.
# Leeg in productie betekent: niemand. In development staat het demoaccount
# er standaard op, zodat het paneel te proberen valt zonder configuratie.
ADMIN_EMAILS=""

# --- Demodata ----------------------------------------------------------
# In development zet de app een demokantoor klaar: drie gebruikers, drie
# projecten, een huisstijl, drie renders en een betaalgeschiedenis (zie
# src/db/seed/). Zet dit op "off" om te zien wat een nieuwe klant ziet: een
# leeg dashboard, een proefperiode en een lege huisstijl. Buiten development
# wordt er sowieso niets geseed.
IMMOREEL_SEED=""

# --- Database (nog niet aangesloten) -----------------------------------
DATABASE_URL=""

# --- Object storage voor uploads en renders ----------------------------
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# Waar geüploade foto's heen gaan zolang er geen bucket is. Leeg betekent:
# RENDER_ASSET_DIR als die er staat, anders RENDER_WORK_DIR/uploads. Zet dit
# gelijk aan RENDER_ASSET_DIR en de renderworker vindt wat je uploadt.
UPLOAD_DIR=""

# --- Renderwachtrij (Redis + BullMQ) -----------------------------------
# De app zet renderjobs in Redis, de worker haalt ze eruit. Zonder deze waarde
# weigert de exportknop en start de worker niet.
REDIS_URL="redis://127.0.0.1:6379"
# Voorvoegsel van alle sleutels in Redis; alleen nodig als je Redis deelt.
QUEUE_PREFIX="immoreel"

# --- Renderworker ------------------------------------------------------
# Aantal renders naast elkaar per workerproces. Hoger dan 2 is meestal
# contraproductief: FFmpeg gebruikt zelf al alle kernen.
RENDER_WORKER_CONCURRENCY="2"
# Pogingen per job, inclusief de eerste.
RENDER_JOB_ATTEMPTS="3"
# Hoe lang een worker een job vasthoudt zonder teken van leven (seconden).
RENDER_LOCK_SECONDS="300"
# Werkmap voor tussenbestanden; wordt na elke job leeggemaakt.
RENDER_WORK_DIR="./.render"
# "ffmpeg" schakelt de echte backend in; anders draait de nepbackend die de
# pijplijn doorloopt zonder te renderen.
RENDER_BACKEND=""
FFMPEG_PATH="ffmpeg"
# Standaard ffprobe naast FFmpeg zelf; alleen nodig als ze elders staan.
FFPROBE_PATH=""

# --- FFmpeg-render -----------------------------------------------------
# Waar de foto's vandaan komen. Een map op schijf wint van een URL.
RENDER_ASSET_DIR=""
RENDER_ASSET_BASE_URL=""
# Map met de muziek van de catalogus: trk_warme_gitaar.mp3, trk_strijkers.m4a, ...
# Leeg betekent: renderen zonder geluid (geen fout).
RENDER_AUDIO_DIR=""
# Lettertype voor de intro-, contact- en logotekst. Zonder dit bestand blijven
# die vlakken leeg; de render gaat gewoon door.
RENDER_FONT_PATH=""
# Hoeveel groter de foto in zoompan gaat dan de uitvoer (1-4). Hoger is vloeiender
# en trager; onder 2 gaat een trage zoom zichtbaar trillen.
RENDER_ZOOMPAN_SUPERSAMPLE="2"
# "cover" snijdt bij naar de beeldverhouding van de export, "contain" legt de
# hele foto op een vlak in RENDER_PAD_COLOR.
RENDER_FIT="cover"
RENDER_PAD_COLOR="black"
# Lager renderen dan de preset vraagt: "1080p", "720p" of "480p". Leeg = zoals de
# preset. Alleen voor een testomgeving; in productie krijgt de gebruiker anders
# een ander formaat dan hij koos.
RENDER_RESOLUTION=""
# Framerate die de preset overschrijft. Leeg = die van de preset.
RENDER_FPS=""
# "1" logt elk FFmpeg-commando zonder het uit te voeren.
RENDER_DRY_RUN=""
# Alleen voor ontwikkelen: de worker meedraaien in het proces van de webserver,
# zodat hij bij de projecten in het geheugen kan. Zie src/workers/README.md.
RENDER_WORKER_INLINE=""

# --- Facturatie (Mollie) -----------------------------------------------
# De API-sleutel bepaalt zelf of je in test of in productie zit: test_ of live_.
# Zonder deze waarde tonen de plannen wel, maar kan er niets afgesloten worden.
MOLLIE_API_KEY="test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# De taal van het betaalscherm van Mollie. nl_BE geeft Bancontact en Belgische
# bankennamen; nl_NL niet.
MOLLIE_LOCALE="nl_BE"
# Alleen nodig bij een OAuth- of organisatiesleutel met meerdere profielen.
MOLLIE_PROFILE_ID=""
#
# Mollie belt zelf naar NEXT_PUBLIC_APP_URL/api/billing/webhook. Daarom moet die
# URL publiek bereikbaar zijn: op localhost wordt er geen webhook verstuurd en
# valt de terugkeerpagina terug op pollen. Zet bij ontwikkelen een tunnel op
# (cloudflared tunnel --url http://localhost:3010) en vul die URL hierboven in.

# --- Meldingen ---------------------------------------------------------
# Meldingen in de app (de bel, de toasts) werken altijd. Deze schakelaar gaat
# alleen over het tweede kanaal: e-mail. Op "1" wordt er per melding gekeken
# wat de gebruiker bij zijn voorkeuren heeft aanstaan; leeg betekent dat er
# niets vertrekt en er ook niets gelogd wordt. Zolang er geen e-mailprovider
# aangesloten is (src/lib/notifications/email.ts, net als src/lib/auth/email.ts)
# gaat de mail naar de console.
NOTIFICATIONS_EMAIL=""
